#!/bin/bash
# Stamp the provided transparent icon.icns onto an INSTALLED FormDAM.app
# (default /Applications/FormDAM.app), re-sign, & nudge Finder/Dock to refresh.
#   setup/apply_icon
#   setup/apply_icon "/Applications/FormDAM.app"
set -e

say() { echo "== $1 =="; }

APP="${1:-/Applications/FormDAM.app}"
ICNS="$(cd "$(dirname "$0")/.." && pwd)/src-tauri/icons/source/icon.icns"

[ -d "$APP" ] || { echo "ERROR: app not found at $APP"; exit 1; }
[ -f "$ICNS" ] || { echo "ERROR: provided icns missing at $ICNS"; exit 1; }

ICON_NAME=$(/usr/libexec/PlistBuddy -c "Print :CFBundleIconFile" "$APP/Contents/Info.plist" 2>/dev/null || echo "icon.icns")
case "$ICON_NAME" in *.icns) : ;; *) ICON_NAME="$ICON_NAME.icns" ;; esac

say "Replacing Resources/$ICON_NAME w/ your provided file"
cp "$ICNS" "$APP/Contents/Resources/$ICON_NAME"
diff -q "$ICNS" "$APP/Contents/Resources/$ICON_NAME" >/dev/null && echo "   byte-identical"

say "Re-signing (modifying a signed bundle invalidates its seal)"
IDENTITY=$(security find-identity -v -p codesigning 2>/dev/null | awk -F '"' '/Developer ID Application/ {print $2; exit}')
if [ -n "$IDENTITY" ]; then
  codesign --force --deep --options runtime -s "$IDENTITY" "$APP" 2>/dev/null || codesign --force --deep -s - "$APP" 2>/dev/null || true
  echo "   signed as: $IDENTITY"
else
  codesign --force --deep -s - "$APP" 2>/dev/null || true
  echo "   ad-hoc signed (no Developer ID certificate found)"
fi

say "Nudging Finder & the Dock to drop their cached icon"
touch "$APP"
killall Finder >/dev/null 2>&1 || true
killall Dock >/dev/null 2>&1 || true

say "Done"
echo "If the old icon lingers, macOS's icon cache is holding it; flush deeply w/:"
echo "  sudo rm -rf /Library/Caches/com.apple.iconservices.store && killall Dock Finder"
echo
echo "macOS 26 reminder: the SYSTEM squircle appears in Dock, Finder & Get Info for"
echo "legacy icns; the file itself is pixel-verified transparent. Save an Icon Composer"
echo "formDAM.icon into src-tauri/icons/ & rebuild to ship the modern format."
