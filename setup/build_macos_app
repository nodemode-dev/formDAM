#!/bin/sh
# Builds the formDAM macOS desktop app (Tauri shell + PyInstaller engine).
# Run this ON macOS: setup/build_macos_app (it resolves the repo root itself)
set -e
cd "$(dirname "$0")/.."

say() { printf '\n== %s ==\n' "$1"; }

say "Checking prerequisites"
command -v python3 >/dev/null || { echo "python3 is required (https://python.org)"; exit 1; }
command -v npm >/dev/null || { echo "npm is required (https://nodejs.org)"; exit 1; }
command -v cargo >/dev/null || { echo "Rust is required: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"; exit 1; }
xcode-select -p >/dev/null 2>&1 || { echo "Xcode command line tools are required: xcode-select --install"; exit 1; }
npx --yes @tauri-apps/cli@2.12.3 --version >/dev/null || { echo "could not get @tauri-apps/cli 2.12.3 from npm (network or registry); nothing was built, rerun setup/build_macos_app when it is back"; exit 1; }

say "Fetching face and visual search models (sha256-verified)"
MODELS=backend/models
mkdir -p "$MODELS"
fetch_model() {
  name="$1"; url="$2"; sha="$3"; target="$MODELS/$name"
  if [ -f "$target" ] && echo "$sha  $target" | shasum -a 256 -c - >/dev/null 2>&1; then
    echo "model ok: $name"
    return
  fi
  curl -fSL --retry 4 --retry-delay 3 --retry-all-errors --connect-timeout 20 -o "$target" "$url" || {
    rm -f "$target"
    echo "could not download $name (network or DNS); nothing else changed, rerun setup/build_macos_app when the connection is back"
    exit 1
  }
  echo "$sha  $target" | shasum -a 256 -c - >/dev/null || { echo "checksum mismatch for $name"; exit 1; }
}
fetch_model face_detection_yunet_2023mar.onnx \
  https://github.com/opencv/opencv_zoo/raw/main/models/face_detection_yunet/face_detection_yunet_2023mar.onnx \
  8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4
fetch_model face_recognition_sface_2021dec.onnx \
  https://github.com/opencv/opencv_zoo/raw/main/models/face_recognition_sface/face_recognition_sface_2021dec.onnx \
  0ba9fbfa01b5270c96627c4ef784da859931e02f04419c829e83484087c34e79
CLIP_BASE=https://huggingface.co/onnx-community/CLIP-ViT-B-32-laion2B-s34B-b79K-ONNX/resolve/de693d0
fetch_model clip_vit_b32_laion2b_int8.onnx "$CLIP_BASE/onnx/model_quantized.onnx" \
  2ac8410fe198fbd003cd97460bdd68653d99c33f53311881cd306190067aee9b
fetch_model clip_vocab.json "$CLIP_BASE/vocab.json" \
  5047b556ce86ccaf6aa22b3ffccfc52d391ea4accdab9c2f2407da5b742d4363
fetch_model clip_merges.txt "$CLIP_BASE/merges.txt" \
  9fd691f7c8039210e0fced15865466c65820d09b63988b0174bfe25de299051a
fetch_model inpainting_lama_2025jan.onnx \
  https://huggingface.co/opencv/inpainting_lama/resolve/aee6d22f0a13e5e35af1c9a1c3afd62841fc6f3f/inpainting_lama_2025jan.onnx \
  7df918ac3921d3daf0aae1d219776cf0dc4e4935f035af81841b40adcf74fdf2
fetch_model image_segmentation_efficientsam_ti_2025april.onnx \
  https://huggingface.co/opencv/image_segmentation_efficientsam/resolve/1e791988b34b2098736003057da0f3e6bc826259/image_segmentation_efficientsam_ti_2025april.onnx \
  4eb496e0a7259d435b49b66faf1754aa45a5c382a34558ddda9a8c6fe5915d77
fetch_model object_detection_yolox_2022nov.onnx \
  https://huggingface.co/opencv/object_detection_yolox/resolve/78c368f74ce73ee28fc7a1be418a598c71b58b52/object_detection_yolox_2022nov.onnx \
  c5c2d13e59ae883e6af3b45daea64af4833a4951c92d116ec270d9ddbe998063
fetch_model bioclip_image_int8.onnx \
  https://huggingface.co/Virien/naturdex-bioclip-onnx/resolve/fa3c062ea31a6e1881b1977fe555b2d481dca730/bioclip-image-int8.onnx \
  ae858e6a807b3a19d1e1f9ecbe3cc5302badf0a6a0cddcc5d1728cdf9d28517a
BIO_DEMO=https://huggingface.co/spaces/imageomics/bioclip-demo/resolve/eeb91af989f1dffc405230a50b4c6214834c918b
if [ ! -f "$MODELS/bioclip_species_int8.npy" ]; then
  fetch_model txt_emb_species.npy "$BIO_DEMO/txt_emb_species.npy" 91ce02dff2433222e3138b8bf7eefa1dd74b30f4d406c16cd3301f66d65ab4ed
  fetch_model txt_emb_species.json "$BIO_DEMO/txt_emb_species.json" 844e6fabc06cac072214d566b78f40825b154efa9479eb11285030ca038b2ece
fi

say "Building the frontend"
cd frontend
[ -d node_modules ] || npm install
npm run build
cd ..

say "Building the engine (Python -> single binary)"
cd backend
rm -rf .venv-package
python3 -m venv .venv-package
. .venv-package/bin/activate
pip install --upgrade pip >/dev/null
pip install -r requirements_macos.txt pyinstaller==6.22.3 pyinstaller-hooks-contrib==2026.10
if [ ! -f models/bioclip_species_int8.npy ]; then
  python -m app.services.species prepare models/txt_emb_species.npy models/txt_emb_species.json models
  rm -f models/txt_emb_species.npy models/txt_emb_species.json
fi
pyinstaller --clean --noconfirm --onedir --name formdam-backend \
  --collect-all uvicorn --collect-all PIL --collect-all pi_heif --exclude-module pillow_heif \
  --collect-all cv2 --collect-all numpy --collect-all rawpy --collect-all exifread \
  --collect-all rapidocr_onnxruntime --collect-all onnxruntime --collect-all cryptography \
  --collect-all ImageCaptureCore --collect-all Quartz \
  --hidden-import objc --hidden-import Foundation --hidden-import AppKit --hidden-import PyObjCTools.AppHelper \
  --hidden-import app.macshare --hidden-import app.familyserver --collect-all pyzipper --collect-all Cryptodome \
  --exclude-module pymobiledevice3 \
  --hidden-import app.main \
  --add-data "../frontend/dist:frontend_dist" \
  --add-data "models:models" \
  --add-data "app/data:app/data" \
  --add-data "../frontend/package.json:." \
  desktop_entry.py
gpl="$(find dist/formdam-backend \( -iname 'libx264*' -o -iname 'libx265*' -o -iname 'librubberband*' -o -iname 'libvidstab*' -o -iname 'libpostproc*' \) | head -1)"
[ -z "$gpl" ] || { echo "GPL FFmpeg library in the engine: $gpl. Reinstall opencv from source without FFmpeg: PIP_NO_BINARY=opencv-python,opencv-python-headless CMAKE_ARGS=-DWITH_FFMPEG=OFF pip install --force-reinstall -r requirements_macos.txt"; exit 1; }
./dist/formdam-backend/formdam-backend --selfcheck
deactivate
cd ..

say "Placing the engine tree (onedir: no per-launch extraction, fast cold start)"
rm -rf src-tauri/binaries/formdam-backend
mkdir -p src-tauri/binaries
cp -R backend/dist/formdam-backend src-tauri/binaries/formdam-backend
ENGINE=src-tauri/binaries/formdam-backend
say "Resolving the engine's file symlinks (tauri ships a link as a second copy of its target, so each becomes a real file & is signed as one)"
find "$ENGINE" -type l ! -path '*.framework/*' -print | while IFS= read -r link; do
  [ -f "$link" ] || continue
  cp -L -p "$link" "$link.resolved" && rm -f "$link" && mv "$link.resolved" "$link" || { echo "could not resolve $link"; exit 1; }
done
ENTITLEMENTS="$PWD/src-tauri/Entitlements.plist"
IDENTITY="${APPLE_SIGNING_IDENTITY:-}"
if [ "$IDENTITY" = "-" ]; then IDENTITY=""; fi
if [ -z "$IDENTITY" ]; then
  IDENTITY=$(security find-identity -v -p codesigning 2>/dev/null | awk -F '"' '/Developer ID Application/ {print $2; exit}')
fi
if [ -n "$IDENTITY" ]; then
  say "Signing the engine's Mach-O files w/ $IDENTITY (hardened runtime, timestamp; Entitlements.plist on executables only)"
  find "$ENGINE" -type f ! -path "$ENGINE/formdam-backend" -print | while IFS= read -r f; do
    case "$(file -b "$f")" in
      *Mach-O*executable*) codesign --force --options runtime --timestamp --entitlements "$ENTITLEMENTS" -s "$IDENTITY" "$f" || { echo "could not sign $f"; exit 1; } ;;
      *Mach-O*) codesign --force --options runtime --timestamp -s "$IDENTITY" "$f" || { echo "could not sign $f"; exit 1; } ;;
    esac
  done
  codesign --force --options runtime --timestamp --entitlements "$ENTITLEMENTS" -s "$IDENTITY" "$ENGINE/formdam-backend"
  codesign --verify --strict "$ENGINE/formdam-backend"
else
  codesign --force --deep -s - "$ENGINE/formdam-backend" 2>/dev/null || true
fi
find "$ENGINE" -type l -path '*.framework/*' -exec rm -f {} +
"$ENGINE/formdam-backend" --selfcheck
echo "engine: src-tauri/binaries/formdam-backend/ (bundled via resources)"

say "Generating app icons from src-tauri/icons/icon.png"
npx --yes @tauri-apps/cli@2.12.3 icon src-tauri/icons/icon.png
say "Restoring the provided .icns (tauri's generated one flattens the transparent background)"
cp src-tauri/icons/source/icon.icns src-tauri/icons/icon.icns

say "Ensuring Info.plist carries the device-import usage string"
python3 - << 'PYPLIST'
import pathlib, plistlib
path = pathlib.Path("src-tauri/Info.plist")
data = plistlib.loads(path.read_bytes()) if path.exists() else {}
want = "formDAM reads photos & videos from a connected iPhone, iPad or camera to import them into your library."
if data.get("NSRemovableVolumesUsageDescription") != want:
    data["NSRemovableVolumesUsageDescription"] = want
    path.write_bytes(plistlib.dumps(data))
print("   NSRemovableVolumesUsageDescription set")
PYPLIST

if [ -n "$IDENTITY" ]; then
  say "Developer ID found; tauri will sign the bundle as: $IDENTITY"
  export APPLE_SIGNING_IDENTITY="$IDENTITY"
else
  say "No Developer ID certificate in the keychain; tauri will ad-hoc sign (fine for local use)"
fi

if [ -d "src-tauri/icons/formDAM.icon" ] && xcrun --find actool >/dev/null 2>&1; then
  say "Icon Composer document found; compiling the modern .icon (this is what removes the macOS 26 Dock backing)"
  rm -rf src-tauri/icons/iconassets
  mkdir -p src-tauri/icons/iconassets
  if xcrun actool src-tauri/icons/formDAM.icon --compile src-tauri/icons/iconassets \
       --app-icon formDAM --output-partial-info-plist src-tauri/icons/iconassets/partial.plist \
       --platform macosx --minimum-deployment-target 26.0 >/dev/null 2>&1 \
     && [ -f "src-tauri/icons/iconassets/Assets.car" ]; then
    python3 - << 'PYWIRE'
import json, pathlib
conf = pathlib.Path("src-tauri/tauri.conf.json")
data = json.loads(conf.read_text())
res = data.setdefault("bundle", {}).setdefault("resources", [])
if "icons/iconassets/Assets.car" not in res:
    res.append("icons/iconassets/Assets.car")
    conf.write_text(json.dumps(data, indent=2) + "\n")
import plistlib
plist = pathlib.Path("src-tauri/Info.plist")
data = plistlib.loads(plist.read_bytes()) if plist.exists() else {}
if data.get("CFBundleIconName") != "formDAM":
    data["CFBundleIconName"] = "formDAM"
    plist.write_bytes(plistlib.dumps(data))
print("   Assets.car wired into the bundle + CFBundleIconName=formDAM")
PYWIRE
  else
    say "actool could not compile formDAM.icon; continuing w/ the legacy icns"
  fi
fi

say "Building the app bundle (this compiles Rust; first run takes a while)"
export CARGO_TARGET_DIR="$PWD/src-tauri/target.nosync"
export CARGO_ENCODED_RUSTFLAGS=""
export RUSTC_WRAPPER=""
unset RUSTFLAGS CARGO_BUILD_RUSTFLAGS CARGO_BUILD_TARGET
STAMP="$CARGO_TARGET_DIR/.build_macos_app.stamp"
mkdir -p "$CARGO_TARGET_DIR"
: > "$STAMP"
rust_compiled() { [ -n "$(find "$CARGO_TARGET_DIR/release/formdam-desktop" "$CARGO_TARGET_DIR/release/bundle/macos/FormDAM.app" -prune -newer "$STAMP" 2>/dev/null)" ]; }
bundle_failed() { say "Rust compiled; the bundle step failed (copying resources, signing or notarization: the error is above), so nothing is rebuilt"; exit 1; }
if ! npx --yes @tauri-apps/cli@2.12.3 build --bundles app -- --locked; then
  if rust_compiled; then bundle_failed; fi
  say "Rust build failed; clearing the release cache once & retrying"
  cargo clean --release --manifest-path src-tauri/Cargo.toml
  if ! npx --yes @tauri-apps/cli@2.12.3 build --bundles app -- --locked; then
    if rust_compiled; then bundle_failed; fi
    say "Rust build failed twice; toolchain details for the report"
    rustc -vV || true
    cargo -V || true
    [ -f "$HOME/.cargo/config.toml" ] && cat "$HOME/.cargo/config.toml"
    echo "Try: rustup update stable && rustup default stable, then rerun setup/build_macos_app"
    exit 1
  fi
fi

APP="$CARGO_TARGET_DIR/release/bundle/macos/FormDAM.app"
say "Verifying the bundled icns (placed BEFORE the build now, so tauri's signature stays untouched)"
if diff -q src-tauri/icons/source/icon.icns "$APP/Contents/Resources/icon.icns" >/dev/null 2>&1; then
  echo "   icon.icns is byte-identical to your provided file & the signature is tauri's own"
else
  echo "   WARNING: bundled icns differs; the packager will repair & re-sign"
fi

say "Packaging the DMG (auto-opening blessed window, volume icon, your icns enforced)"
setup/package_dmg "$APP" "$CARGO_TARGET_DIR/release/bundle"

say "Done"
echo "App:  $APP  (icon.icns byte-identical to your provided file)"
echo "DMG:  see the packager line above"
echo
echo "Already installed a copy in /Applications? Stamp its icon in place any time:"
echo "  setup/apply_icon"
echo
echo "Icon: your transparent icns ships byte-exact. (Optional: an Icon Composer formDAM.icon in src-tauri/icons/ upgrades to the modern format on the next build.)"
echo
if [ -n "$IDENTITY" ]; then
  echo "Signed as: $IDENTITY (notarize before public release; the packager prints the commands)"
else
  echo "Ad-hoc signed (no Developer ID certificate found). First launch: right-click > Open."
  echo "To sign for real: enroll at developer.apple.com, create a Developer ID Application"
  echo "certificate in Xcode > Settings > Accounts, & rebuild: it is picked up automatically."
fi
echo
echo "ffmpeg stays a user-supplied PATH binary (video features need it):"
echo "  brew install ffmpeg"
