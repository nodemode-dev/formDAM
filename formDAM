#!/usr/bin/env bash
# formDAM - macOS/Linux launcher for the local browser build. Banner, install (idempotent), boot.
# Every step lives in setup/; this file only sequences them.
set -e
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

if [ "${1:-}" = desktop ] && [ "${2:-}" = build ]; then
  shift 2
  exec ./build_app "$@"
fi

chmod +x setup/formDAM_banner setup/formDAM_oc_install setup/formDAM_boot 2>/dev/null || true

# Boot banner. Never allowed to fail the launch: cosmetics do not gate startup.
bash setup/formDAM_banner || true

setup/formDAM_oc_install
exec setup/formDAM_boot
