{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "formDAM",
  "version": "1.13.9",
  "identifier": "ai.nodemode.dam",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist"
    },
    "resources": {
      "binaries/formdam-backend": "formdam-backend"
    }
  }
}
