{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "formDAM",
  "version": "../frontend/package.json",
  "identifier": "ai.nodemode.dam",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/polkit-1/actions/ai.nodemode.formdam.policy": "linux/ai.nodemode.formdam.policy"
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "binaries/formdam-backend": "formdam-backend"
    }
  }
}
