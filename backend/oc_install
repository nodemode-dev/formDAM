#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"

python3 -m venv venv
# shellcheck disable=SC1091
source venv/bin/activate
python -m pip install --upgrade pip
if [[ "$OSTYPE" == "darwin"* ]]; then
  pip install -r requirements_macos.txt
else
  pip install -r requirements.txt
fi
pip install -r requirements-dev.txt

MODELS_DIR="models"
mkdir -p "$MODELS_DIR"
sha256_of() {
  if command -v shasum > /dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    python -c 'import hashlib, sys; print(hashlib.sha256(open(sys.argv[1], "rb").read()).hexdigest())' "$1"
  fi
}
fetch_model() {
  local name="$1" url="$2" sha="$3"
  local target="$MODELS_DIR/$name"
  if [ -f "$target" ] && [ "$(sha256_of "$target")" = "$sha" ]; then
    echo "model ok: $name"
    return
  fi
  echo "downloading $name"
  curl -fSL --retry 4 --retry-delay 3 --retry-all-errors --connect-timeout 20 -o "$target" "$url" || { rm -f "$target"; echo "could not download $name (network or DNS); rerun ./DAM when the connection is back"; exit 1; }
  [ "$(sha256_of "$target")" = "$sha" ] || { echo "checksum mismatch for $name"; exit 1; }
}
fetch_model face_detection_yunet_2023mar.onnx \
  https://github.com/opencv/opencv_zoo/raw/main/models/face_detection_yunet/face_detection_yunet_2023mar.onnx \
  8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4
