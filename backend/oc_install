  7df918ac3921d3daf0aae1d219776cf0dc4e4935f035af81841b40adcf74fdf2
fetch_model image_segmentation_efficientsam_ti_2025april.onnx \
  https://huggingface.co/opencv/image_segmentation_efficientsam/resolve/1e791988b34b2098736003057da0f3e6bc826259/image_segmentation_efficientsam_ti_2025april.onnx \
  4eb496e0a7259d435b49b66faf1754aa45a5c382a34558ddda9a8c6fe5915d77
